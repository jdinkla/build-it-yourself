---
import Base from '../../layouts/Base.astro';import {withBase} from '../../lib/base';
export function getStaticPaths(){return [{params:{tool:'link-library'},props:{kind:'links',title:'Link Library',description:'Save useful pages with a note about why they matter. Search, export, and keep your collection.',guide:'bookmarks'}},{params:{tool:'decision-workbench'},props:{kind:'decision',title:'Decision Workbench',description:'Three options. Three criteria. Make your assumptions visible, then change them.',guide:'decisions'}},{params:{tool:'one-page-week'},props:{kind:'week',title:'One-page Week',description:'Three priorities and seven days. A small plan you can print, revise, and keep.',guide:'week'}}];}
const {kind,title,description,guide}=Astro.props;
---
<Base title={title} description={description}><div class="wrap tool-page"><header class="page-head"><h1>{title}</h1><p>{description}</p></header><p class="tool-intro">From Issue 001 · <a href={withBase('/'+guide+'/')}>Read the companion guide</a>. Data stays in your browser; export a backup. Browser saving can fail or be cleared. This is not an encrypted vault; other scripts on this GitHub Pages origin can access saved data. Use non-sensitive information.</p><link rel="stylesheet" href={withBase('/workshop/tool.css')}/><div data-workshop={kind}></div><noscript><p>This tool needs JavaScript to edit and export. The companion guide is available without it.</p></noscript><script is:inline src={withBase('/workshop/tool.js')}></script></div></Base>
